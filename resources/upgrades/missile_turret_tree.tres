[gd_resource type="Resource" script_class="UpgradeTreeData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/upgrade_tree_data.gd" id="1_tree"]
[ext_resource type="Script" path="res://scripts/data/upgrade_node_data.gd" id="2_node"]

[sub_resource type="Resource" id="node_more_missiles"]
script = ExtResource("2_node")
id = "more_missiles"
display_name = "More Missiles"
description = "Store 1 additional missile for bigger bursts."
mineral_cost = 75
power_cost = 10.0
upgrade_time = 3.0
requires = Array[String]([])
excludes = Array[String]([])
stat_modifiers = [{"component": "C_MissileLauncher", "property": "missile_capacity", "operation": "add", "value": 1}]

[sub_resource type="Resource" id="node_heavy_payload"]
script = ExtResource("2_node")
id = "heavy_payload"
display_name = "Heavy Payload"
description = "Increases missile damage by 50%."
mineral_cost = 100
power_cost = 10.0
upgrade_time = 3.0
requires = Array[String]([])
excludes = Array[String]([])
stat_modifiers = [{"component": "C_MissileLauncher", "property": "damage", "operation": "multiply", "value": 1.5}]

[sub_resource type="Resource" id="node_faster_spawn"]
script = ExtResource("2_node")
id = "faster_spawn"
display_name = "Faster Spawn"
description = "Missiles replenish 30% quicker."
mineral_cost = 75
power_cost = 10.0
upgrade_time = 3.0
requires = Array[String]([])
excludes = Array[String]([])
stat_modifiers = [{"component": "C_MissileLauncher", "property": "missile_spawn_interval", "operation": "multiply", "value": 0.7}]

[sub_resource type="Resource" id="node_rapid_fire"]
script = ExtResource("2_node")
id = "rapid_fire"
display_name = "Rapid Fire"
description = "Fire sequence 40% faster."
mineral_cost = 100
power_cost = 12.0
upgrade_time = 3.5
requires = Array[String](["more_missiles"])
excludes = Array[String]([])
stat_modifiers = [{"component": "C_MissileLauncher", "property": "missile_fire_interval", "operation": "multiply", "value": 0.6}]

[sub_resource type="Resource" id="node_wider_blast"]
script = ExtResource("2_node")
id = "wider_blast"
display_name = "Wider Blast"
description = "Increases explosion radius by 50%."
mineral_cost = 100
power_cost = 10.0
upgrade_time = 3.0
requires = Array[String]([])
excludes = Array[String]([])
stat_modifiers = [{"component": "C_MissileLauncher", "property": "aoe_radius", "operation": "multiply", "value": 1.5}]

[resource]
script = ExtResource("1_tree")
tree_id = "missile_turret"
nodes = [SubResource("node_more_missiles"), SubResource("node_heavy_payload"), SubResource("node_faster_spawn"), SubResource("node_rapid_fire"), SubResource("node_wider_blast")]
