[gd_resource type="Resource" script_class="UpgradeTreeData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/upgrade_tree_data.gd" id="1_tree"]
[ext_resource type="Script" path="res://scripts/data/upgrade_node_data.gd" id="2_node"]

[sub_resource type="Resource" id="node_efficient_drill"]
script = ExtResource("2_node")
id = "efficient_drill"
display_name = "Efficient Drill"
description = "Mines 30% faster."
mineral_cost = 100
power_cost = 10.0
upgrade_time = 3.0
requires = Array[String]([])
excludes = Array[String]([])
stat_modifiers = [{"component": "C_MiningStation", "property": "mining_interval", "operation": "multiply", "value": 0.7}]

[sub_resource type="Resource" id="node_deep_core"]
script = ExtResource("2_node")
id = "deep_core"
display_name = "Deep Core Extractor"
description = "Extracts 50% more minerals per cycle."
mineral_cost = 125
power_cost = 12.0
upgrade_time = 4.0
requires = Array[String]([])
excludes = Array[String]([])
stat_modifiers = [{"component": "C_MiningStation", "property": "mine_amount", "operation": "multiply", "value": 1.5}]

[resource]
script = ExtResource("1_tree")
tree_id = "mining_station"
nodes = [SubResource("node_efficient_drill"), SubResource("node_deep_core")]
