; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Cosmos"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
MusicManager="*res://scripts/autoload/music_manager.gd"
SfxManager="*res://scripts/autoload/sfx_manager.gd"
PowerGraphManager="*res://scripts/autoload/power_graph_manager.gd"
BuildManager="*res://scripts/autoload/build_manager.gd"
StructureRenderManager="*res://scripts/autoload/structure_render_manager.gd"
EnemyManager="*res://scripts/autoload/enemy_manager.gd"
MapLoader="*res://scripts/autoload/map_loader.gd"
SelectionManager="*res://scripts/autoload/selection_manager.gd"
StoryCampaignManager="*res://scripts/autoload/story_campaign_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
GameSession="*res://scripts/autoload/game_session.gd"
ECS="*uid://dfqwl5njvdnmq"
LineBatchManager="*res://scripts/autoload/line_batch_manager.gd"
GameWorld="*uid://c160il8fy8l7o"
UpgradeManager="*res://scripts/autoload/upgrade_manager.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gecs/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/cosmos_export/plugin.cfg")

